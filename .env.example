# Twilio (https://console.twilio.com) -- see README for setup
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token
TWILIO_FROM=+15551234567
MY_PHONE=+15559876543

# Which notifier to use: twilio | telegram | ntfy | console
NOTIFIER=twilio

# For NOTIFIER=telegram: message @BotFather -> /newbot -> copy the token, then run
#   python check.py --telegram-setup      (finds your chat id and fills these in)
# TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=123456789
# For NOTIFIER=ntfy (free push notifications, no account): pick a long random topic name
# NTFY_TOPIC=pricewatch-9f3a2c

# Politeness: random delay between requests, in seconds
MIN_DELAY=2
MAX_DELAY=6
# Set to 0 to ignore robots.txt (not recommended)
RESPECT_ROBOTS=1
# Text "needs attention" after this many consecutive failures
FAIL_THRESHOLD=3

# Storage. Leave unset to keep price history in data/pricewatch.db (committed to the repo).
# Or use Supabase: Dashboard -> Connect -> "Session pooler" URI (IPv4-compatible; GitHub runners need it).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Web app (multi-user, sign-in). Both from Supabase -> Project Settings -> API. The anon key is public.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# How often each item is re-checked, in minutes (the workflow runs every 5 min and scrapes what's due)
CHECK_INTERVAL_MINUTES=5
# GitHub's own cron is unreliable (hours between runs). A fine-grained personal access token with
# "Actions: read and write" on the repo lets setup_trigger.py install a Supabase pg_cron job that
# starts the workflow every 5 minutes. github.com -> Settings -> Developer settings -> Fine-grained tokens.
# GITHUB_DISPATCH_TOKEN=github_pat_...
# Items without a target price alert on any drop, except tiny ones: ignore drops smaller than this percent
MIN_DROP_PCT=1
# Cap per signed-in user (enforced in the database by setup_supabase.py / deploy.sh)
MAX_ITEMS_PER_USER=100
